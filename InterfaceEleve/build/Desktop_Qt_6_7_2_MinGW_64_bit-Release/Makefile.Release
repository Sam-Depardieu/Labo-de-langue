	$(COPY_FILE) --parents ../../attenteprof.ui ../../interfaceaudio.ui ../../interfaceenregistrement.ui ../../interfaceqcm.ui ../../interfacevideo.ui ../../mainwindow.ui $(DISTDIR)/


