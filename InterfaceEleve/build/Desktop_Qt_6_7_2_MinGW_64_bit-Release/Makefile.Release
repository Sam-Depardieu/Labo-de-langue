####### Compile

release/attenteprof.o: ../../attenteprof.cpp ../../attenteprof.h \
		ui_attenteprof.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/attenteprof.o ../../attenteprof.cpp

release/audioCommunicator.o: ../../audioCommunicator.cpp ../../audioCommunicator.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/audioCommunicator.o ../../audioCommunicator.cpp

release/avancementqcm.o: ../../avancementqcm.cpp ../../avancementqcm.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/avancementqcm.o ../../avancementqcm.cpp

release/interfaceaudio.o: ../../interfaceaudio.cpp ../../interfaceaudio.h \
		../../mainwindow.h \
		../../audioCommunicator.h \
		ui_interfaceaudio.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o release/interfaceaudio.o ../../interfaceaudio.cpp

