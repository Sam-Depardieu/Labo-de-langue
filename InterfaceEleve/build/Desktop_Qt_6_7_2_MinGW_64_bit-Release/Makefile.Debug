####### Compile

debug/attenteprof.o: ../../attenteprof.cpp ../../attenteprof.h \
		ui_attenteprof.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/attenteprof.o ../../attenteprof.cpp

debug/audioCommunicator.o: ../../audioCommunicator.cpp ../../audioCommunicator.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/audioCommunicator.o ../../audioCommunicator.cpp

debug/interfaceaudio.o: ../../interfaceaudio.cpp ../../interfaceaudio.h \
		ui_interfaceaudio.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/interfaceaudio.o ../../interfaceaudio.cpp

debug/interfaceenregistrement.o: ../../interfaceenregistrement.cpp ../../interfaceenregistrement.h \
		ui_interfaceenregistrement.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/interfaceenregistrement.o ../../interfaceenregistrement.cpp

debug/interfaceqcm.o: ../../interfaceqcm.cpp ../../interfaceqcm.h \
		../../interfaceenregistrement.h \
		ui_interfaceqcm.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/interfaceqcm.o ../../interfaceqcm.cpp

debug/interfacevideo.o: ../../interfacevideo.cpp ../../interfacevideo.h \
		ui_interfacevideo.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/interfacevideo.o ../../interfacevideo.cpp

debug/main.o: ../../main.cpp ../../mainwindow.h \
		../../audioCommunicator.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/main.o ../../main.cpp

debug/mainwindow.o: ../../mainwindow.cpp ../../mainwindow.h \
		../../interfaceaudio.h \
		../../interfaceenregistrement.h \
		../../interfaceqcm.h \
		../../interfacevideo.h \
		ui_mainwindow.h \
		../../attenteprof.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/mainwindow.o ../../mainwindow.cpp

debug/qrc_images.o: debug/qrc_images.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/qrc_images.o debug/qrc_images.cpp

debug/qrc_videos.o: debug/qrc_videos.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o debug/qrc_videos.o debug/qrc_videos.cpp

